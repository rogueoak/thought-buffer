#!/usr/bin/env bash
# After a BRANCH checkout, regenerate the Xcode project if the set of files under
# ios/ differs between the two commits. Skips file-level checkouts.
# Args: $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout, 0 for a file checkout.
set -euo pipefail

[ "${3:-0}" = "1" ] || exit 0

root="$(git rev-parse --show-toplevel)"

if git diff --quiet "$1" "$2" -- ios/ 2>/dev/null; then
  exit 0
fi

"$root/scripts/generate-project.sh"
